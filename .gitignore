# Generated / binary media — keep out of Git history
# Text, source, configuration, documentation, and other human-readable artifacts remain trackable.

# Images
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.heic
*.heif
*.avif

# Audio
*.mp3
*.wav
*.flac
*.ogg
*.oga
*.m4a
*.aac
*.opus
*.wma

# Video
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.mpeg
*.mpg

# Other common binary media
*.ico

# Volatile runtime state: never commit (privacy + 5 s auto-sync churn). Added 2026-09-29 (WO-ECO).
/ENERGY/state/
/ENERGY/ports/
/GITHUB/plumbing/state/
*.pid
*.lock

# Live high-churn log streams (BLE heartbeat, poller current). Archives stay tracked. Added 2026-09-29 (WO-ECO/WO-SRV).
# Untracked via owner-approved git rm --cached 2026-09-29 ~01:25 HST; files stay on disk.
/Logs/Energy/ava-ecoflow-ble.log
/Logs/Automations/automations_current.log
/Logs/Communications/council-relay.log

# Previous-datasets archive: bulk/binary/private content stays local; only each dataset README is tracked. Added 2026-09-29.
/Archive/Previous-Datasets/*/*
!/Archive/Previous-Datasets/*/README.md
# Weather daemon data tree (intended as the separate RootRecord-Weather-Database working tree) — never in this repo.
/WEATHER/
# Energy sqlite store (binary).
/ROOTRECORD/

# Ollama runtime/error/pull logs (volatile, may hold prompts): contents local only; .gitkeep preserves the layout. Builds + Modelfiles stay tracked. Added 2026-09-29.
/Logs/AI/Ollama/Runtime/*
!/Logs/AI/Ollama/Runtime/.gitkeep
/Logs/AI/Ollama/Errors/*
!/Logs/AI/Ollama/Errors/.gitkeep
/Logs/AI/Ollama/Pulls/*
!/Logs/AI/Ollama/Pulls/.gitkeep

# Desk screenshots (may show private desktop info) — local only. Added 2026-09-29.
/Logs/Migration/*.png

# FLM server logs record full prompts/requests — local only. Added 2026-09-29.
/GITHUB/logs/
/Logs/AI/FLM/*
!/Logs/AI/FLM/.gitkeep
